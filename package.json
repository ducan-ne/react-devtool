{
  "name": "react-devtool",
  "version": "0.2.3",
  "description": "Easy solution to have your own internal devtool, unleash the DX of React",
  "keywords": [
    "debugging",
    "development",
    "devtool",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/ducan-ne/react-devtool",
  "bugs": {
    "url": "https://github.com/ducan-ne/react-devtool/issues"
  },
  "license": "MIT",
  "author": "ducan-ne",
  "repository": {
    "type": "git",
    "url": "https://github.com/ducan-ne/react-devtool.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/devtool.js",
  "types": "./dist/devtool.d.ts",
  "exports": {
    ".": {
      "import": "./dist/devtool.js",
      "types": "./dist/devtool.d.ts"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "types": "./dist/ui.d.ts"
    }
  },
  "scripts": {
    "dev": "vite --port 1234",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "rl-next": "bunx bumpp && bun run build && npm publish --tag next",
    "rl-latest": "bunx bumpp && bun run build && npm publish",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.59.1",
    "@preact/preset-vite": "^2.10.1",
    "@preact/signals": "^2.2.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "antd": "^5.26.3",
    "bippy": "^0.3.17",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "^0.20.14",
    "jsdom": "^29.1.1",
    "knip": "^5.61.3",
    "playwright-core": "^1.53.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-inspector": "^6.0.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tree-kill": "^1.2.2",
    "typescript": "~5.8.3",
    "vite": "npm:rolldown-vite@7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.5",
    "web-vitals": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "preact": "^10.26.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
